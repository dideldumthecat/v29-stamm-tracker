# Template for backend/.env.local on the production server (create it there by hand, never commit it).
# Replace every value; .rsync-exclude keeps the real file from being overwritten or deleted on deploy.

APP_ENV=prod
# Generate with: openssl rand -hex 16
APP_SECRET=change-me-32-hex-characters-here

# The domain the app runs on, without trailing slash.
DEFAULT_URI=https://stamm-tracker.example.org
APP_PUBLIC_URL=https://stamm-tracker.example.org

# Host, database name, user and password from the IONOS database overview.
DATABASE_URL="mysql://db_user:db_password@db_host.hosting-data.io:3306/db_name?serverVersion=11.8.0-MariaDB&charset=utf8mb4"
