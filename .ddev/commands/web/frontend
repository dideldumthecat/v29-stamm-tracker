#!/usr/bin/env bash

## Description: Run npm in frontend/ from anywhere
## Usage: frontend [npm args]
## Example: "ddev frontend run dev" (app and administration together), "ddev frontend run dev:app" or "dev:admin" (one only), "ddev frontend run build", "ddev frontend install -D tailwindcss -w app" or "ddev frontend exec -w app vitest run"

cd /var/www/html/frontend && npm "$@"
