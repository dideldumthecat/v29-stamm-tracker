{
  "name": "v29-stamm-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "admin",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w app --",
    "dev:admin": "npm run dev -w admin --",
    "build": "npm run build -w app -w admin --",
    "tests": "npm run tests -w app -w admin -w shared --",
    "test:unit": "npm run test:unit -w app --",
    "test:e2e": "npm run test:e2e -w app -w admin --",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write app/src app/e2e admin/src admin/e2e shared"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
